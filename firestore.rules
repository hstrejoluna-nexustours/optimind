rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation probe document
    match /test/connection {
      allow read: if true;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.streak is number &&
        data.streak >= 0 &&
        data.streak <= 10000 &&
        (!('plan' in data) || data.plan in ['free', 'pro', 'clinical']) &&
        (!('totalWorkouts' in data) || (data.totalWorkouts is number && data.totalWorkouts >= 0)) &&
        (!('bookmarkedTerms' in data) || (data.bookmarkedTerms is list && data.bookmarkedTerms.size() <= 100));
    }

    // ABCDE Workout Entry Validation
    function isValidAbcdeEntry(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string &&
        isValidId(data.id) &&
        data.title is string &&
        data.title.size() <= 250 &&
        data.adversity is string &&
        data.adversity.size() <= 3000 &&
        data.belief is string &&
        data.belief.size() <= 3000 &&
        data.category in ['trabajo', 'relaciones', 'salud_habitos', 'estudio', 'finanzas', 'personal'] &&
        data.classifications is map &&
        data.consequences is map &&
        data.refutations is map &&
        data.energization is map;
    }

    // Mood Check-In Validation
    function isValidMoodCheckIn(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string &&
        isValidId(data.id) &&
        data.score is number &&
        data.score >= 1 &&
        data.score <= 10 &&
        data.energy in ['calma', 'sereno', 'inquieto', 'agotado'] &&
        (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    // User Root Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: ABCDE Entries
      match /entries/{entryId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(entryId) && isValidAbcdeEntry(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(entryId) && isValidAbcdeEntry(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }

      // Subcollection: Mood Check-ins
      match /moods/{moodId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(moodId) && isValidMoodCheckIn(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(moodId) && isValidMoodCheckIn(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(moodId);
      }
    }
  }
}
